# Copy to .env and adjust. .env is git-ignored; never commit real values.

# Folder with the source reports (<wellbore>/WELL/*.JSON). Read-only; may be an external disk.
WELLGRAPH_DATA_DIR=/Volumes/your-disk/reports

# Folder with the built graph (Parquet files) that the MCP server reads.
WELLGRAPH_KG_DIR=data/kg

# Language model for event extraction: any OpenAI-compatible chat-completions endpoint.
WELLGRAPH_LLM_BASE_URL=https://your-resource.openai.azure.com/openai/v1
WELLGRAPH_LLM_API_KEY=
WELLGRAPH_LLM_MODEL=your-model-or-deployment-name
